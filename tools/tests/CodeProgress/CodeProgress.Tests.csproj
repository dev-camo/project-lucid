<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectLucid.CodeProgressTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../code-progress/TypeIdentity.cs" Link="TypeIdentity.cs" />
  </ItemGroup>
  <Target Name="RequirePinnedSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NETCoreSdkVersion)' != '10.0.403'" Text="Use the pinned .NET SDK 10.0.403 for code progress reader tests." />
  </Target>
</Project>
