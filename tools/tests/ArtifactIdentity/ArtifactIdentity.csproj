<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProjectLucid.ArtifactIdentityTests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../code-progress/SourceDocuments.cs" Link="SourceDocuments.cs" />
    <Compile Include="../../../Assets/Editor/RecoveredProof/LucidArtifactIdentity.cs" Link="LucidArtifactIdentity.cs" />
  </ItemGroup>
  <Target Name="RequirePinnedSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NETCoreSdkVersion)' != '10.0.401'" Text="Use the pinned .NET SDK 10.0.401 for artifact identity tests." />
  </Target>
</Project>
