<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the pinned source's nuget.config (which names only nuget.samboy.dev). Every package in the
     committed lock files resolves from nuget.org with identical content hashes, so no other feed is
     trusted; restore runs with RestoreLockedMode. -->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
